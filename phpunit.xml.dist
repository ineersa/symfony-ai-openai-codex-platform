<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.2/phpunit.xsd" bootstrap="vendor/autoload.php" cacheDirectory="var/phpunit" failOnAllIssues="true">
    <testsuites><testsuite name="package"><directory>tests</directory></testsuite></testsuites>
    <source><include><directory>src</directory></include></source>
</phpunit>
